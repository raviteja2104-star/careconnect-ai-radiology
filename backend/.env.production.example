# ─── CareConnect Backend — Production Environment Variables ───────────────────
# Copy to .env (never commit real values)

NODE_ENV=production
PORT=5000

# MongoDB Atlas — replace with production URI
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/careconnect?retryWrites=true&w=majority

# JWT — generate a 64-char random secret: openssl rand -hex 32
JWT_SECRET=<64-character-random-hex>
JWT_EXPIRE=7d

# CORS — comma-separated list of allowed frontend origins (no trailing slashes)
ALLOWED_ORIGINS=https://careconnect.care,https://www.careconnect.care,https://business.careconnect.care,https://admin.careconnect.care

# Razorpay — production keys from Razorpay dashboard
RAZORPAY_KEY_ID=rzp_live_<key>
RAZORPAY_KEY_SECRET=<razorpay_secret>

# SabPaisa — production credentials
SABPAISA_CLIENT_CODE=<client_code>
SABPAISA_AUTH_KEY=<auth_key>
SABPAISA_AUTH_IV=<auth_iv>
SABPAISA_USERNAME=<username>
SABPAISA_PASSWORD=<password>

# SendGrid — email delivery
SENDGRID_API_KEY=SG.<key>
SENDGRID_FROM_EMAIL=noreply@careconnect.care
PROVIDER_NOTIFY_EMAIL=providers@careconnect.care

# AI service — set to production AI service URL or omit if not deployed
AI_SERVICE_URL=https://ai.careconnect.in

# Redis — for rate-limiting, cache, idempotency
REDIS_URL=redis://<host>:6379

# Twilio — OTP and SMS
TWILIO_ACCOUNT_SID=AC<sid>
TWILIO_AUTH_TOKEN=<token>
TWILIO_PHONE_NUMBER=+1<number>

# ABDM — National Health Authority sandbox → production
ABDM_BASE_URL=https://dev.abdm.gov.in/gateway
ABDM_CLIENT_ID=<client_id>
ABDM_CLIENT_SECRET=<client_secret>

# Orthanc PACS
ORTHANC_URL=https://pacs.careconnect.in
ORTHANC_USERNAME=<orthanc_user>
ORTHANC_PASSWORD=<orthanc_pass>

# Feature flags
USE_NEW_AUTH_SERVICE=false
