# ─── CareConnect Web Portal — Production Environment Variables ────────────────
# Copy to .env.production.local (never commit real values)

# Backend API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=https://api.careconnect.care
BACKEND_URL=https://api.careconnect.care

# Site canonical URL
NEXT_PUBLIC_SITE_URL=https://www.careconnect.care

# Razorpay — only the KEY ID is public-safe (never put secret here)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_<key>

# SendGrid (server-side Next.js route handlers only — never NEXT_PUBLIC_*)
SENDGRID_API_KEY=SG.<key>
SENDGRID_FROM_EMAIL=noreply@careconnect.care
PROVIDER_NOTIFY_EMAIL=providers@careconnect.care

# NextAuth (if applicable)
NEXTAUTH_URL=https://www.careconnect.care
NEXTAUTH_SECRET=<64-character-random-hex>
