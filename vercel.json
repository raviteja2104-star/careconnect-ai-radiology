{
  "version": 2,
  "builds": [
    {
      "src": "backend/src/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/src/server.js" },
    { "src": "/ohif(.*)", "dest": "backend/src/server.js" },
    { "src": "/viewer(.*)", "dest": "backend/src/server.js" }
  ]
}
