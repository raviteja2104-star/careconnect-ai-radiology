{
  "expo": {
    "name": "CareConnect",
    "slug": "careconnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.careconnect.app"
    },
    "android": {
      "package": "com.careconnect.app"
    },
    "web": {
      "bundler": "metro",
      "template": "./web/index.html",
      "viewport": {
        "width": 393,
        "initialScale": 1,
        "maximumScale": 1
      },
      "backgroundColor": "#0A1628",
      "themeColor": "#00BFA6"
    },
    "plugins": [
      "expo-asset",
      "expo-font"
    ]
  }
}