{
  "expo": {
    "name": "CareConnect",
    "slug": "careconnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.careconnect.app"
    },
    "android": {
      "package": "com.careconnect.app",
      "kotlinVersion": "1.9.25"
    },
    "web": {
      "bundler": "metro",
      "template": "./web/index.html",
      "viewport": {
        "width": 393,
        "initialScale": 1,
        "maximumScale": 1
      },
      "backgroundColor": "#0A1628",
      "themeColor": "#00BFA6"
    },
    "plugins": [
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "f572236c-ac63-4ca4-9afe-96fd9b589939"
      }
    },
    "owner": "raviteja.2104"
  }
}
